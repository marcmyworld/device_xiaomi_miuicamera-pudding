From 3fe79ea9dab74b89e6c305e42482ea1d89834fe7 Mon Sep 17 00:00:00 2001
From: marcmyworld <moviesminister@gmail.com>
Date: Mon, 23 Nov 2026 15:45:07 +0530
Subject: Bypass zoom map stream registration in full aspect ratio

On SM8850, the Optical Flow Engine (OFE) hardware downscaler with factor 6.4 maps the 19.5:9 crop ROI to a 304-line height window. Because the satmap stream minimum buffer height is 306 lines, the ROI cannot cover the satmap buffer (OFE output buffer[2]), causing GeoLibOfe to fail and triggering consecutive crash recovery resulting in camera provider SIGABRT.

Omit registering the zoom map surface in full aspect ratio to prevent allocating OFE buffer[2], keeping full screen preview and capture stable.
---
 .../android/camera/module/Camera2Module.smali | 34 ++++++++++++++++++-
 smali/k8/j.smali                              |  9 +++++
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/smali/com/android/camera/module/Camera2Module.smali b/smali/com/android/camera/module/Camera2Module.smali
index 816d1ed4..c4746c2b 100644
--- a/smali/com/android/camera/module/Camera2Module.smali
+++ b/smali/com/android/camera/module/Camera2Module.smali
@@ -3596,8 +3596,40 @@
 .end method
 
 .method private getZoomMapSurface()Landroid/view/Surface;
-    .locals 0
+    .locals 2
+
+    iget v0, p0, Lcom/android/camera/module/l;->mModuleIndex:I
+
+    invoke-static {v0}, Lcom/android/camera/data/data/m;->u(I)Ljava/lang/String;
+
+    move-result-object v0
+
+    if-eqz v0, :cond_normal
+
+    const-string v1, "19.5x9"
+
+    invoke-virtual {v1, v0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_ret_null
+
+    invoke-static {v0}, Lue/a;->b(Ljava/lang/String;)F
+
+    move-result v0
+
+    invoke-static {v0}, Lw2/b;->c0(F)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_normal
+
+    :cond_ret_null
+    const/4 p0, 0x0
+
+    return-object p0
 
+    :cond_normal
     iget-object p0, p0, Lcom/android/camera/module/Camera2Module;->mZoomMapController:Lk8/j;
 
     if-eqz p0, :cond_0
diff --git a/smali/k8/j.smali b/smali/k8/j.smali
index 37fcb7b8..a5f60e3c 100644
--- a/smali/k8/j.smali
+++ b/smali/k8/j.smali
